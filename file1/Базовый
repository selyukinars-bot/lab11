import { useState } from "react";

function LikeButton({ title }) {
    const [likes, setLikes] = useState(0);

    function addLike() {
        setLikes(likes + 1);
    }

    function resetLikes() {
        setLikes(0);
    }

    return (
        <div className="like-card">
            <h2>{title}</h2>

            <p className="likes">
                ❤️ {likes}
            </p>

            <button onClick={addLike}>
                Поставить лайк
            </button>

            <button onClick={resetLikes} className="reset">
                Сбросить
            </button>
        </div>
    );
}

export default LikeButton;
