import { useState } from "react";
import CourseCard from "./components/CourseCard";

function App() {
    const courses = [
        {
            id: 1,
            title: "Основы JavaScript",
            description: "Изучение основ программирования на JavaScript.",
            details: "На курсе изучаются переменные, функции, массивы, объекты и работа с DOM.",
            duration: "4 недели"
        },
        {
            id: 2,
            title: "React для начинающих",
            description: "Создание интерфейсов с помощью React.",
            details: "На курсе изучаются компоненты, props, state, useState и события.",
            duration: "6 недель"
        },
        {
            id: 3,
            title: "HTML и CSS",
            description: "Создание и оформление веб-страниц.",
            details: "На курсе изучаются HTML-разметка, CSS-стили, Flexbox и Grid.",
            duration: "3 недели"
        }
    ];

    const [selectedCourse, setSelectedCourse] = useState(null);

    return (
        <div className="container">
            <h1>Каталог курсов</h1>

            <div className="course-list">
                {courses.map(course => (
                    <CourseCard
                        key={course.id}
                        course={course}
                        onSelect={setSelectedCourse}
                    />
                ))}
            </div>

            {selectedCourse && (
                <div className="details">
                    <h2>{selectedCourse.title}</h2>

                    <p>{selectedCourse.details}</p>

                    <p>
                        <strong>Продолжительность:</strong>{" "}
                        {selectedCourse.duration}
                    </p>

                    <button onClick={() => setSelectedCourse(null)}>
                        Закрыть
                    </button>
                </div>
            )}
        </div>
    );
}

export default App;
