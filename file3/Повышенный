import { useState } from "react";
import RoomCard from "./components/RoomCard";

function App() {
    const [rooms, setRooms] = useState([
        {
            id: 1,
            number: 101,
            capacity: 25,
            equipment: "Проектор, компьютер",
            booked: false
        },
        {
            id: 2,
            number: 202,
            capacity: 40,
            equipment: "Интерактивная доска",
            booked: false
        },
        {
            id: 3,
            number: 303,
            capacity: 30,
            equipment: "Компьютеры, проектор",
            booked: true
        },
        {
            id: 4,
            number: 404,
            capacity: 50,
            equipment: "Проектор, микрофон",
            booked: false
        }
    ]);

    // Бронирование аудитории
    function bookRoom(id) {
        setRooms(prevRooms =>
            prevRooms.map(room =>
                room.id === id
                    ? { ...room, booked: true }
                    : room
            )
        );
    }

    // Отмена бронирования
    function cancelBooking(id) {
        setRooms(prevRooms =>
            prevRooms.map(room =>
                room.id === id
                    ? { ...room, booked: false }
                    : room
            )
        );
    }

    const bookedCount = rooms.filter(room => room.booked).length;

    return (
        <div className="container">
            <h1>Система бронирования аудиторий</h1>

            <div className="statistics">
                <p>Всего аудиторий: {rooms.length}</p>
                <p>Забронировано: {bookedCount}</p>
                <p>Свободно: {rooms.length - bookedCount}</p>
            </div>

            <div className="room-list">
                {rooms.map(room => (
                    <RoomCard
                        key={room.id}
                        room={room}
                        onBook={bookRoom}
                        onCancel={cancelBooking}
                    />
                ))}
            </div>
        </div>
    );
}

export default App;
