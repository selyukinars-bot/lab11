function RoomCard({ room, onBook, onCancel }) {
    return (
        <div className="room-card">
            <h2>Аудитория №{room.number}</h2>

            <p>Вместимость: {room.capacity} человек</p>
            <p>Оборудование: {room.equipment}</p>

            <p className={room.booked ? "busy" : "free"}>
                {room.booked ? "Забронирована" : "Свободна"}
            </p>

            {room.booked ? (
                <button
                    className="cancel-button"
                    onClick={() => onCancel(room.id)}
                >
                    Отменить бронь
                </button>
            ) : (
                <button onClick={() => onBook(room.id)}>
                    Забронировать
                </button>
            )}
        </div>
    );
}

export default RoomCard;
